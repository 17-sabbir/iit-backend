Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Never expose application internals or dependency sources directly.
RewriteRule ^(?:config|database|migrations|tools|vendor|tcpdf)(?:/|$) - [F,L,NC]

# Route PHP endpoint URLs through Laravel instead of executing legacy files directly.
RewriteCond %{REQUEST_URI} !^/public/index\.php$ [NC]
RewriteRule ^.+\.php$ public/index.php [L,QSA]

# Route extensionless requests through Laravel's front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L,QSA]

AddDefaultCharset UTF-8
php_flag display_errors off
php_flag log_errors on
